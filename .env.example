TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=123456789

# Use one of these for Supabase/PostgreSQL production storage.
DATABASE_URL=postgresql://postgres.example:password@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DB_URL=postgresql://...

# Optional Google discovery provider. Disabled unless config.yaml enables discovery.serpapi.
SERPAPI_KEY=replace_me

# Optional Google Alerts RSS feed secrets referenced from config.yaml.
GOOGLE_ALERT_RSS_1=https://www.google.com/alerts/feeds/...
GOOGLE_ALERT_RSS_2=https://www.google.com/alerts/feeds/...
